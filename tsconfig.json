{
  "compilerOptions": {
    "moduleResolution": "node16",
    "strict": true,
    "strictNullChecks": true,
    "target": "es6",
    "module": "node16",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "noEmit": true,
    "sourceMap": true,
    "plugins": [
      {
        "transform": "./src/undebug.js"
      }
    ]
  },
  "include": [
    "src/lib/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
